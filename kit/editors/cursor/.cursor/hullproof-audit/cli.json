{
  "version": 1,
  "permissions": {
    "allow": [],
    "deny": [
      "Write(**)",
      "Shell(*)",
      "WebFetch(*)",
      "Mcp(*:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  }
}

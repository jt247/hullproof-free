{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Write(.devin/config.json)",
      "Write(.devin/hooks.json)",
      "Write(.devin/hooks.v1.json)",
      "Write(tools/hullproof/hooks/**)",
      "Write(.claude/hooks/**)"
    ]
  }
}
